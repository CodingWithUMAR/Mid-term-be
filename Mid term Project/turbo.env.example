# Copy these settings into your local .env file. Do not commit .env.
NODE_ENV=development
PORT=5000
# React dev server origin. In production set this to your exact Vercel domain.
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/turbo_store?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTP_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="TURBO Store <your-email@gmail.com>"
# Comma-separated admin email addresses. Only these verified accounts can access admin routes.
ADMIN_EMAILS=your-admin-email@example.com
# Optional bank transfer instructions shown at checkout.
BANK_ACCOUNT_DETAILS=Bank: Your Bank | Account title: TURBO | IBAN: PK00XXXX0000000000000000
# Only set true when deployed behind a trusted reverse proxy.
TRUST_PROXY=false
